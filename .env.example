# متغيرات البيئة الخاصة بالبوت لاستخدامها في Railway أو بيئة الانتاج

# توكن البوت الخاص بك من @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# قائمة معرفات المشرفين (مفصولة بفاصلة)
