{
  "rewrites": [
    {
      "source": "/set_webhook",
      "destination": "/api/index.py?action=set_webhook"
    },
    {
      "source": "/api/set_webhook",
      "destination": "/api/index.py?action=set_webhook"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/index.py?action=webhook"
    },
    {
      "source": "/webhook",
      "destination": "/api/index.py?action=webhook"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
